[Unit]
Description=ambNassos (Festeve)
After=network.target

[Service]
WorkingDirectory=/var/www/festeve/ambNassos
EnvironmentFile=/var/www/festeve/ambNassos/.env
ExecStart=/var/www/festeve/ambNassos/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8204 app:app
Restart=always

[Install]
WantedBy=default.target
